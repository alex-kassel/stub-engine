{
    "name": "alex-kassel/stub-engine",
    "description": "Hierarchical template and stub scaffolding engine with token interpolation and host overrides for PHP and Laravel",
    "keywords": [
        "laravel",
        "stubs",
        "templates",
        "scaffolding",
        "code-generation",
        "generator",
        "package-development"
    ],
    "homepage": "https://github.com/alex-kassel/stub-engine",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Kassel",
            "homepage": "https://github.com/alex-kassel"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\StubEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\StubEngine\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKassel\\StubEngine\\StubEngineServiceProvider"
            ],
            "aliases": {
                "StubEngine": "AlexKassel\\StubEngine\\Facades\\StubEngine"
            }
        }
    }
}
